# Copy to .env (git-ignored) and fill in. Never commit the real key.
CRUSTDATA_API_KEY=
# Optional: credits one case may spend on its live airline check (default 3)
FLIGHTBACK_CASE_CEILING=3
# Optional: id of the Crustdata airline-news watch. Leave empty and POST /api/watch/ensure creates one (free).
FLIGHTBACK_WATCH_ID=
